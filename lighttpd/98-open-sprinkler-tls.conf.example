server.modules += ( "mod_redirect", "mod_openssl" )

# Replace these paths with a certificate and private key for this controller.
ssl.pemfile = "/etc/lighttpd/certs/open-sprinkler/fullchain.pem"
ssl.privkey = "/etc/lighttpd/certs/open-sprinkler/privkey.pem"

$SERVER["socket"] == ":443" {
    ssl.engine = "enable"
}

# Browser tokens and session cookies must never travel over plain HTTP.
$HTTP["scheme"] == "http" {
    url.redirect = ("" => "https://${url.authority}${url.path}${qsa}")
}
