[Unit]
Description=Pi Sprinkler Timer scheduler and GPIO controller
After=local-fs.target

[Service]
Type=simple
User=www-data
Group=www-data
SupplementaryGroups=gpio
RuntimeDirectory=pi-sprinkler
RuntimeDirectoryMode=0750
WorkingDirectory=/run/pi-sprinkler
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/test -r /usr/lib/cgi-bin/sprinkler.config
ExecStart=/usr/bin/python3 /usr/lib/cgi-bin/sprinkler.py
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
