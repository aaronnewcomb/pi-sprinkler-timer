[Unit]
Description=Pi Sprinkler Timer controller and web API
After=local-fs.target network.target

[Service]
Type=simple
User=pi-sprinkler
Group=pi-sprinkler
SupplementaryGroups=gpio
RuntimeDirectory=pi-sprinkler
RuntimeDirectoryMode=0750
StateDirectory=pi-sprinkler
StateDirectoryMode=0750
WorkingDirectory=/run/pi-sprinkler
UMask=0027
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/test -r /etc/pi-sprinkler/pi-sprinkler.ini
ExecStartPre=/usr/bin/test -r /etc/pi-sprinkler/api-token
ExecStart=/opt/pi-sprinkler/.venv/bin/pi-sprinkler --config /etc/pi-sprinkler/pi-sprinkler.ini --api-token-file /etc/pi-sprinkler/api-token
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
